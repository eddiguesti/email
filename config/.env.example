# ===========================================
# LB-BOT Configuration Template
# Copy this to config/.env and fill in your values
# ===========================================

# ============= Azure AD (Graph API) =============
# App registered at portal.azure.com with Delegated permissions:
# Mail.Read, Mail.ReadWrite, Mail.Send, Calendars.Read, Calendars.ReadWrite, User.Read, offline_access
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret

# ============= OAuth Authentication =============
# Callback URI — must match exactly what is registered in the Azure AD app
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ============= Application URLs =============
# Public-facing URL of the Next.js web app (used for post-login redirects, cookie domain)
# Production: https://app.laurencebrosset-avocats.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Azure Functions base URL — includes the /api route prefix
# Production: https://lb-bot-api.azurewebsites.net/api
# Used server-side only (Next.js API routes & auth callback)
AZURE_API_URL=http://localhost:7071/api

# Azure Functions host key — Azure Portal → Function App → App keys → default
# Required for the Graph subscription creation call on login
AZURE_FUNCTIONS_KEY=your-azure-functions-host-key

# ============= Supabase (State Management) =============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ============= Session & Encryption =============
# 64-char hex strings — generate with: openssl rand -hex 32
SESSION_SECRET=generate-with-openssl-rand-hex-32
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
INTERNAL_SERVICE_KEY=generate-with-openssl-rand-hex-32

# ============= Azure Service Bus (Queuing) =============
# Azure Portal → Service Bus → Namespace → Shared Access Policies → RootManageSharedAccessKey
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=yourkey
EMAIL_PROCESS_QUEUE_NAME=email-process
AUTO_SEND_QUEUE_NAME=auto-send

# ============= Azure Blob Storage (Attachments) =============
# Azure Portal → Storage Account → Access Keys → Connection string
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=lbbot-attachments

# ============= Graph Webhook Configuration =============
# For local dev: use ngrok (pnpm --filter @lb-bot/config tunnel)
# For production: Azure Functions HTTPS URL
WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/webhook/graph
WEBHOOK_CLIENT_STATE=generate-with-openssl-rand-hex-32

# ============= Monitored Mailboxes =============
# Comma-separated list of mailboxes the bot monitors
MONITORED_MAILBOXES=cabinet@yourfirm.com

# ============= Firm Configuration =============
FIRM_NAME=Your Firm Name
FIRM_EMAIL=cabinet@yourfirm.com
FIRM_ADDRESS=
FIRM_PHONE=

# ============= Kleos API (Wolters Kluwer) =============
# Credentials from your Kleos admin console → API integrations
KLEOS_CLIENT_ID=KleosFR.YOURFIRM_xxxxxx
KLEOS_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KLEOS_TIMEOUT=30000
KLEOS_RETRY_COUNT=3

# ============= AI (xAI / Grok) =============
XAI_API_KEY=your-xai-api-key

# ============= Push Notifications (VAPID) =============
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ============= Webflow (optional — marketing site CMS) =============
WEBFLOW_API_TOKEN=your-webflow-api-token
WEBFLOW_SITE_ID=your-webflow-site-id

# ============= Application Insights (optional) =============
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ============= Development Flags =============
# SECURITY: DEV_MODE=true enables the demo auth bypass.
# This must be absent or set to "false" in ALL production environments.
# Unlike NEXT_PUBLIC_* vars, this is evaluated at runtime and never baked into the bundle.
DEV_MODE=false
